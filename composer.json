{
    "name": "e0ipso/schema-forms",
    "description": "Creates form definitions from JSON Schema property definitions and display configuration.",
    "license": "GPL-2.0-or-later",
    "type": "library",
    "keywords": [
        "json-schema",
        "drupal",
        "form-api",
        "forms"
    ],
    "authors": [
        {
            "name": "Mateu Aguiló Bosch",
            "email": "mateu@mateuaguilo.com"
        }
    ],
    "homepage": "https://github.com/e0ipso/schema-forms-php",
    "support": {
        "issues": "https://github.com/e0ipso/schema-forms-php/issues",
        "source": "https://github.com/e0ipso/schema-forms-php"
    },
    "require": {
        "php": ">=8.3",
        "ext-json": "*",
        "e0ipso/shaper": "^1.2",
        "justinrainbow/json-schema": "^5.2 || ^6.3"
    },
    "require-dev": {
        "drupal/coder": "^8.3",
        "drupal/core-dev": "~11.3.0",
        "drupal/core-recommended": "^11",
        "ergebnis/composer-normalize": "^2.47",
        "nikic/php-parser": "^5.6",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "phpro/grumphp-shim": "^2.14",
        "phpunit/phpunit": "^11.5",
        "povils/phpmnd": "^3.6",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "suggest": {
        "drupal/core": "Required for the SchemaForms\\Drupal classes; tested with Drupal 11."
    },
    "autoload": {
        "psr-4": {
            "SchemaForms\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SchemaForms\\Tests\\": "tests/src"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": false,
            "ergebnis/composer-normalize": true,
            "php-http/discovery": true,
            "phpro/grumphp-shim": true,
            "phpstan/extension-installer": true,
            "tbachert/spi": true
        },
        "platform": {
            "php": "8.3.0"
        }
    },
    "scripts": {
        "test": "php vendor/bin/grumphp.phar run"
    }
}
